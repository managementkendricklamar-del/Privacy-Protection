# Firebase Configuration - Example
# Copy this file to '.env' and fill in the values.
# These variables must also be configured in Netlify's Environment Variables settings for production.

# Your Firebase Web App API Key. Can be found in Project Settings in the Firebase Console.
FIREBASE_API_KEY=YOUR_API_KEY

# Your Firebase Web App Auth Domain (e.g., your-project-id.firebaseapp.com).
FIREBASE_AUTH_DOMAIN=YOUR_AUTH_DOMAIN

# Your Firebase Project ID.
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID

# Your Firebase Storage Bucket URL (e.g., your-project-id.firebasestorage.app).
FIREBASE_STORAGE_BUCKET=YOUR_STORAGE_BUCKET

# Your Firebase Messaging Sender ID.
FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID

# Your Firebase Web App ID (e.g., 1:1234567890:web:abcdef123456).
FIREBASE_APP_ID=YOUR_APP_ID
